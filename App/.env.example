# Copy to .env and adjust. No secrets are required for the local baseline.

APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (canonical store)
POSTGRES_USER=okc
POSTGRES_PASSWORD=
POSTGRES_DB=okc
POSTGRES_HOST_PORT=5433
# Used when the backend runs natively (outside Docker):
DATABASE_URL=postgresql+psycopg://okc:<password>@127.0.0.1:5433/okc

# --- Elasticsearch (derived search index; rebuildable from PostgreSQL / Markdown)
SEARCH_BACKEND=elasticsearch          # elasticsearch | memory
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=okc-sections

# --- Corpus
# Native runs read DATA_DIR directly; Docker mounts HOST_DATA_DIR read-only at /data/markdown.
DATA_DIR=
HOST_DATA_DIR=

# --- ML models (downloaded on first use, ~1 GB; keep both on for the best answers)
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NLI_ENABLED=true
NLI_MODEL=cross-encoder/nli-deberta-v3-base
INSTALL_ML=true

# --- Optional local LLM via Ollama (none | ollama)
LLM_PROVIDER=none
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_HOST_FROM_DOCKER=http://host.docker.internal:11434
LLM_MODEL=gemma4:e4b
LLM_TIMEOUT_S=120

# --- Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001
